# Shared
PRYSM_HOST=0.0.0.0
PRYSM_PORT=8001

# Vision service
PRYSM_CAMERA_SERIAL=
PRYSM_WIDTH=3840
PRYSM_HEIGHT=2160
PRYSM_DIST_REF_MM=1000.0
PRYSM_TOLERANCE_MM=10.0
PRYSM_PLC_MODE=noop
PRYSM_VIDEO_SOURCE=
# If true and no camera is found, use a synthetic video source
PRYSM_ALLOW_SYNTHETIC_FALLBACK=false
PRYSM_CAMERA_OPEN_RETRIES=5
PRYSM_CAMERA_OPEN_RETRY_S=2.0
# Use "synthetic" for Docker on Windows (no USB passthrough)

# API service
PRYSM_VISION_SERVICE_URL=http://localhost:8001
PRYSM_VISION_PUBLIC_URL=
PRYSM_USE_STREAM_PROXY=true
PRYSM_UI_TITLE=Prysm Monitor
PRYSM_STATUS_REFRESH_MS=1000
